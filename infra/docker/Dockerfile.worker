# Worker image: runs BullMQ handlers + spawns claude CLI for AI tasks.
# Uses tsx (root devDep) as the TS runtime — no separate compile step needed
# because all workspace packages export TypeScript source directly.
FROM node:22-alpine

# Install opencode-ai CLI (claude-code lives in Dockerfile.sandbox, used via kubectl exec)
RUN npm install -g opencode-ai

# Install git (required by claude for repo operations inside the worker pod)
RUN apk add --no-cache git

RUN corepack enable

WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile

ENV NODE_ENV=production

CMD ["node_modules/.bin/tsx", "packages/worker/src/start.ts"]
