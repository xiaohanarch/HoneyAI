# Worker image: runs BullMQ handlers + spawns claude CLI for AI tasks.
# Uses tsx (root devDep) as the TS runtime — no separate compile step needed
# because all workspace packages export TypeScript source directly.
FROM node:22-alpine

# Install opencode-ai CLI + @ai-sdk/anthropic for custom bailian-token-plan provider
# (claude-code lives in Dockerfile.sandbox, used via kubectl exec)
RUN npm install -g opencode-ai @ai-sdk/anthropic

# Install git (required by claude for repo operations inside the worker pod)
RUN apk add --no-cache git

RUN corepack enable

WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile

ENV NODE_ENV=production

RUN chmod +x /app/infra/docker/worker-entrypoint.sh

ENTRYPOINT ["/app/infra/docker/worker-entrypoint.sh"]
