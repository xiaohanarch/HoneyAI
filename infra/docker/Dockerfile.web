# ── Stage 1: builder ───────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
RUN corepack enable

WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile

ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @honeyai/web build

# ── Stage 2: runner ────────────────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Next.js standalone output includes a self-contained server + minimal node_modules.
# In a pnpm monorepo the standalone dir mirrors the workspace root, so server.js
# lives at packages/web/server.js relative to the standalone root.
COPY --from=builder /app/packages/web/.next/standalone ./
COPY --from=builder /app/packages/web/.next/static     ./packages/web/.next/static
# public/ may be empty; RUN mkdir ensures the runner stage always has the dir
RUN mkdir -p ./packages/web/public
COPY --from=builder /app/packages/web/public/          ./packages/web/public/

EXPOSE 3000
CMD ["node", "packages/web/server.js"]
