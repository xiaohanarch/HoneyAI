DATABASE_URL=postgresql://honeyai:honeyai_dev@localhost:55432/honeyai
NODE_ENV=development
LOG_LEVEL=debug

# --- LLM Engine (optional env overrides, primary config is honeyai.config.json) ---
# LLM_ENGINE=opencode        # override engine: 'claude' | 'opencode'
# LLM_MODEL=anthropic/claude-sonnet-4-6  # override model (opencode format: provider/model)
ANTHROPIC_API_KEY=            # optional — claude CLI falls back to OAuth if absent

# --- @honeyai/web (NextAuth v5) ---
# Required: 32+ random bytes (generate: openssl rand -base64 32)
NEXTAUTH_SECRET=

# Required: full URL of the deployed web app (e.g. http://localhost:3000 for local dev)
NEXTAUTH_URL=http://localhost:3000

# Set to "true" ONLY in development to enable the Credentials dev provider (ADR-029).
# Must be absent or "false" in production. Enforced by module-level guard in
# packages/web/lib/auth/dev-credentials.ts
DEV_AUTH_ENABLED=false

# --- @honeyai/web Welcome wizard (slice 4.3) ---
# GitHub App install URL shown to user in Welcome step 2 (Q11 GA2 / ADR-038)
GITHUB_APP_INSTALL_URL=https://github.com/apps/your-honeyai-app/installations/new
NEXT_PUBLIC_GITHUB_APP_INSTALL_URL=https://github.com/apps/your-honeyai-app/installations/new

# ── GitHub App (Phase 2.5 / 切片 3) ──────────────────────────────────────────
# Register at https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=
# OAuth credentials (same App's OAuth section)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
